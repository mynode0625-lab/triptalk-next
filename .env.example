# ─────────────────────────────────────────────────────────────
# TripTalk — 소셜 로그인 환경변수
#
# 하나도 채우지 않으면 로그인 페이지는 "데모 모드"로 동작합니다.
# (화면 흐름만 시연하고 외부로 아무것도 전송하지 않습니다.)
#
# NEXT_PUBLIC_ 접두사가 붙은 값만 브라우저 번들에 들어갑니다.
# 시크릿은 절대 NEXT_PUBLIC_ 으로 두지 마세요.
#
# 각 개발자 콘솔에 아래 Redirect URI 를 등록해야 합니다.
#   https://<배포-도메인>/login
#   http://localhost:3000/login        (로컬 테스트용)
# ─────────────────────────────────────────────────────────────

# 카카오 — https://developers.kakao.com (내 애플리케이션 → 앱 키 → REST API 키)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 네이버 — https://developers.naver.com/apps (애플리케이션 등록 → Client ID)
NEXT_PUBLIC_NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Google — https://console.cloud.google.com
#          (API 및 서비스 → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID / 웹 애플리케이션)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# 서버 TTS (선택) — 캐릭터 목소리를 사람에 가깝게
#
# 채워두면 방문자가 각자 API 키를 넣지 않아도 OpenAI `gpt-4o-mini-tts` 로
# 자연스러운 미국식 발음을 들려줍니다. 비워두면 브라우저 내장 음성을 씁니다.
#
# 주의: 이 키로 만들어지는 음성은 서버 비용이 발생합니다.
#       공개 배포 시에는 `app/api/tts/route.ts` 에 호출 제한을 두는 것을 권합니다.
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
